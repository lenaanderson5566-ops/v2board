{
    "name": "v2board-console",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc --noEmit && vite build && node scripts/package-frontends.mjs",
        "package:frontends": "node scripts/package-frontends.mjs",
        "test": "vitest run",
        "locales:generate": "node scripts/expand-locales.mjs"
    },
    "dependencies": {
        "@stripe/stripe-js": "^9.17.0",
        "ace-builds": "^1.44.0",
        "dompurify": "^3.2.0",
        "i18next": "^26.4.2",
        "lucide-react": "^0.468.0",
        "markdown-it": "^15.0.2",
        "qrcode.react": "^4.2.0",
        "react": "^19.0.0",
        "react-ace": "^15.0.0",
        "react-dom": "^19.0.0",
        "react-i18next": "^17.0.15",
        "react-markdown-editor-lite": "^1.4.2"
    },
    "overrides": {
        "react-markdown-editor-lite": {
            "nanoid": "5.1.16"
        }
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.3",
        "@types/markdown-it": "^14.2.0",
        "@types/node": "^26.6.3",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.0",
        "jsdom": "^29.1.1",
        "opencc-js": "^1.4.2",
        "prettier": "^3.9.9",
        "typescript": "^5.7.0",
        "vite": "^6.0.0",
        "vitest": "^4.1.11"
    }
}
