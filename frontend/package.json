{
    "name": "v2board-console",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc --noEmit && vite build && node scripts/package-frontends.mjs",
        "package:frontends": "node scripts/package-frontends.mjs",
        "test": "vitest run",
        "test:payments": "vitest run src/user/BillingFlow.test.tsx src/user/PaymentCheckout.test.tsx src/user/PaymentMethodPicker.test.tsx src/user/PaymentPolling.test.tsx src/user/OrderHelp.test.tsx src/user/PendingOrderNotice.test.tsx src/shared/order-price.test.ts src/shared/field-values.test.ts src/shared/v10-api.test.ts src/admin/payment-fields.test.ts src/admin/Payments.test.tsx src/admin/PaymentCallbackHistory.test.tsx src/admin/billing-price-input.test.ts src/admin/AdminBillingCurrency.test.tsx",
        "test:mfa": "vitest run Mfa Passkey passkey UserAuth.test AdminAuth.test",
        "test:mail": "vitest run AdminMail MailHealth EmailInvites",
        "test:coupons": "vitest run Coupon"
    },
    "dependencies": {
        "@radix-ui/react-dropdown-menu": "2.2.1",
        "@radix-ui/react-tabs": "1.2.1",
        "@stripe/stripe-js": "^9.17.0",
        "ace-builds": "^1.44.0",
        "dompurify": "^3.2.0",
        "i18next": "^26.4.2",
        "lucide-react": "^0.468.0",
        "markdown-it": "^15.0.3",
        "qrcode.react": "^4.2.0",
        "react": "^19.0.0",
        "react-ace": "^15.0.0",
        "react-dom": "^19.0.0",
        "react-i18next": "^17.0.15",
        "react-markdown-editor-lite": "^1.4.2",
        "web-vitals": "6.2.3"
    },
    "overrides": {
        "react-markdown-editor-lite": {
            "nanoid": "5.1.16"
        }
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.3",
        "@types/markdown-it": "^14.2.0",
        "@types/node": "^26.6.3",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.9",
        "typescript": "^5.7.0",
        "vite": "^6.4.5",
        "vitest": "^4.1.12"
    }
}
